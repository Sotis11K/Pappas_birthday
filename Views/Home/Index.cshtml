@{
    ViewData["Title"] = "Happy Birthday";
}


<section id="page1-login">
    <img src="~/images/flag.png" class="login-background-image" />
    <div id="login-img-container">
        <img src="~/images/login-icon.png" />
        <span>User</span>
    </div>

    <input id="login-input" type="text"/>
    <button id="login-button">Enter</button>
</section>


<section id="page1">
    <span id="page1-text">Enter 4 digit code</span>
    <input type="text" id="page1-input" maxlength="4" />
    <button id="page1-button">Enter</button>
</section>
<img id="hacker-background" src="~/images/hacker_background.gif"/>
<div class="page1-correct-code">
    <audio class="morse-audio" controls>
        <source src="~/audio/morse.wav" type="audio/wav" />
    </audio>
</div>